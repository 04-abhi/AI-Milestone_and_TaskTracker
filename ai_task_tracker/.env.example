# Application
APP_NAME="AI Task Tracker"
APP_VERSION="1.0.0"
APP_ENV="development"  # development | staging | production
DEBUG=True
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST="127.0.0.1"
PORT=8000
WORKERS=1

# Database
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/ai_task_tracker"
DATABASE_URL_SYNC="postgresql://postgres:password@localhost:5432/ai_task_tracker"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis (for Celery & Caching)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_NAME="AI Task Tracker"
EMAILS_FROM_EMAIL="noreply@aitasktracker.com"

# Sentry (optional)
SENTRY_DSN=""

# AI Engine
AI_SUGGESTION_INTERVAL_HOURS=24
PRODUCTIVITY_ANALYSIS_DAYS=30

# Admin
FIRST_ADMIN_EMAIL="admin@aitasktracker.com"
FIRST_ADMIN_PASSWORD="Admin@123456"
FIRST_ADMIN_USERNAME="admin"
