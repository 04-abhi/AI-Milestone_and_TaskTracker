# ═══════════════════════════════════════════════════════════════════
# AI Task Tracker v3 — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────
APP_NAME=AI Task Tracker
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-min-32-chars-change-this-in-production!!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Server ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── PostgreSQL ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/ait_v3
DATABASE_URL_SYNC=postgresql://postgres:root@localhost:5432/ait_v3

# ── Admin Seed ───────────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@ait.com
FIRST_ADMIN_PASSWORD=Admin@1234
FIRST_ADMIN_USERNAME=admin

# ── Groq AI ──────────────────────────────────────────────────────────
# Sign up FREE at https://console.groq.com
# Go to: API Keys → Create API Key → copy it here
#
# Available models (fast, free tier):
#   llama-3.3-70b-versatile   ← recommended (best quality)
#   llama3-70b-8192           ← good alternative
#   mixtral-8x7b-32768        ← fast, lower quality
#   gemma2-9b-it              ← lightweight option
#
GROQ_API_KEY=GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# ── Web Push (Optional) ──────────────────────────────────────────────
# Generate with: python scripts/generate_vapid.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@ait.com
